+	XUngrabKey(dpy, AnyKey, AnyModifier, root);
+
+	vmfocused = selmon && selmon->sel && selmon->sel->isvm;
+
+	if (vmfocused) {
+		/* Leave one emergency binding available to DWM. */
+		if ((code = XKeysymToKeycode(dpy, VMESCAPEKEY)))
+			for (j = 0; j < LENGTH(modifiers); j++)
+				XGrabKey(dpy, code, VMESCAPEMOD | modifiers[j],
+				         root, True, GrabModeAsync, GrabModeAsync);
+		return;
 	}
+
+	for (i = 0; i < LENGTH(keys); i++)
+		if ((code = XKeysymToKeycode(dpy, keys[i].keysym)))
+			for (j = 0; j < LENGTH(modifiers); j++)
+				XGrabKey(dpy, code, keys[i].mod | modifiers[j],
+				         root, True, GrabModeAsync, GrabModeAsync);
 }
 
+void
+vmrelease(const Arg *arg)
+{
+	if (selmon->sel)
+		unfocus(selmon->sel, 1);
+
+	selmon->sel = NULL;
+	XSetInputFocus(dpy, root, RevertToPointerRoot, CurrentTime);
+	grabkeys();
+	drawbars();
+}
